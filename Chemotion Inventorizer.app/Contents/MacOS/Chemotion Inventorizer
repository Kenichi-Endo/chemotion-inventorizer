#!/bin/sh

# The application bundle lives beside src/, so derive the project directory
# from this launcher instead of copying the Python source into the bundle.
launcher_dir=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd -P) || exit 1
project_dir=$(CDPATH= cd -- "$launcher_dir/../../.." && pwd -P) || exit 1
source="$project_dir/src/chemotion_inventorizer/__main__.py"
bootstrap="$project_dir/src/chemotion_inventorizer/bootstrap.py"
icon="$project_dir/Chemotion Inventorizer.app/Contents/Resources/chemotion-inventorizer-icon.png"

if [ ! -r "$source" ] || [ ! -r "$bootstrap" ]; then
    printf '%s\n' 'Chemotion Inventorizer source was not found. Keep the app inside the project folder.' >&2
    exit 1
fi

export CHEMOTION_INVENTORIZER_ICON="$icon"
export PYTHONDONTWRITEBYTECODE=1
export PATH="/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:$PATH"

# Finder supplies only a minimal PATH. Prefer the Python.org framework install,
# which is also where this project's supported Python is installed.
if [ -x /Library/Frameworks/Python.framework/Versions/Current/bin/python3 ]; then
    python=/Library/Frameworks/Python.framework/Versions/Current/bin/python3
elif [ -x /usr/local/bin/python3 ]; then
    python=/usr/local/bin/python3
else
    python=$(command -v python3 2>/dev/null || true)
fi

if [ -z "$python" ]; then
    printf '%s\n' 'Python 3 was not found. Install Python 3.10 or newer to run Chemotion Inventorizer.' >&2
    exit 1
fi

# The bootstrap installs project dependencies into a private environment.
log_dir="$HOME/Library/Logs/Chemotion Inventorizer"
mkdir -p "$log_dir" || exit 1
log_file="$log_dir/launcher.log"
exec "$python" "$bootstrap" "$@" >>"$log_file" 2>&1
